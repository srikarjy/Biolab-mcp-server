# Durable project metadata (free Turso/libSQL)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token

# Durable accepted RAG vectors (free Neon Postgres + pgvector)
PGVECTOR_DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Free-first embeddings; deterministic workflow fallback, not a validated
# scientific embedding model.
BIOLAB_FREE_EMBEDDINGS=1

# Hosted deployments must require API keys.
BIOLAB_REQUIRE_AUTH=true
BIOLAB_ALLOW_ANONYMOUS=false
